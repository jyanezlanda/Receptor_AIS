        </item>
        <item>
         <widget class="QGroupBox" name="grpComandos">
          <property name="title">
           <string>Comandos rápidos</string>
          </property>
          <layout class="QGridLayout" name="comandosLayout">
           <item row="0" column="0">
            <widget class="QPushButton" name="btnIniciar">
             <property name="text">
              <string>Iniciar receptor</string>
             </property>
            </widget>
           </item>
           <item row="0" column="1">
            <widget class="QLineEdit" name="txtCmdIniciar">
             <property name="text">
              <string>cd /media/mmcblk0p1/apps &amp;&amp; ./start.sh &amp;&amp; (nohup ./adrf_server -c adrf6850.conf &gt; /tmp/adrf.log 2&gt;&amp;1 &amp;) &amp;&amp; (nohup ./adc_server &gt; /tmp/adc.log 2&gt;&amp;1 &amp;) &amp;&amp; echo "Servidores iniciados (adc_server: 1003, adrf_server: 1005)"</string>
             </property>
            </widget>
           </item>
           <item row="1" column="0">
            <widget class="QPushButton" name="btnDetener">
             <property name="text">
              <string>Detener receptor</string>
             </property>
            </widget>
           </item>
           <item row="1" column="1">
            <widget class="QLineEdit" name="txtCmdDetener">
             <property name="text">
              <string>killall adc_server adrf_server 2&gt;/dev/null; echo "Servidores detenidos"</string>
             </property>
            </widget>
           </item>
           <item row="2" column="0">
            <widget class="QPushButton" name="btnEstadoRp">
             <property name="text">
              <string>Estado</string>
             </property>
            </widget>
           </item>
           <item row="2" column="1">
            <widget class="QLineEdit" name="txtCmdEstado">
             <property name="text">
              <string>uptime; free -m; for p in adc_server adrf_server ais_sim.sh; do pgrep -f $p &gt; /dev/null &amp;&amp; echo "$p: en ejecución" || echo "$p: detenido"; done</string>
             </property>
            </widget>
           </item>
           <item row="3" column="0">
            <widget class="QPushButton" name="btnLog">
             <property name="text">
              <string>Ver registro</string>
             </property>
            </widget>
           </item>
           <item row="3" column="1">
            <widget class="QLineEdit" name="txtCmdLog">
             <property name="text">
              <string>tail -n 15 /tmp/adc.log /tmp/adrf.log /tmp/ais_sim.log 2&gt;/dev/null</string>
             </property>
            </widget>
           </item>
           <item row="4" column="0">
            <widget class="QPushButton" name="btnSimIniciar">
             <property name="text">
              <string>Iniciar simulación AIS</string>
             </property>
            </widget>
           </item>
           <item row="4" column="1">
            <widget class="QLineEdit" name="txtCmdSimIniciar">
             <property name="text">
              <string>(nohup sh /media/mmcblk0p1/apps/ais_sim.sh &gt; /tmp/ais_sim.log 2&gt;&amp;1 &amp;) &amp;&amp; sleep 1 &amp;&amp; cat /tmp/ais_sim.log</string>
             </property>
            </widget>
           </item>
           <item row="5" column="0">
            <widget class="QPushButton" name="btnSimDetener">
             <property name="text">
              <string>Detener simulación AIS</string>
             </property>
            </widget>
           </item>
           <item row="5" column="1">
            <widget class="QLineEdit" name="txtCmdSimDetener">
             <property name="text">
              <string>pkill -f ais_sim.sh; pkill -f "nc -l -p 1004"; echo "Simulación detenida"</string>
             </property>
            </widget>
           </item>
           <item row="6" column="0">
            <widget class="QPushButton" name="btnReiniciar">
             <property name="text">
              <string>Reiniciar Red Pitaya</string>
             </property>
            </widget>
           </item>
           <item row="6" column="1">
            <widget class="QLineEdit" name="txtCmdReiniciar">
             <property name="text">
              <string>reboot</string>
             </property>
            </widget>
           </item>
           <item row="7" column="0">
            <widget class="QPushButton" name="btnApagar">
             <property name="text">
              <string>Apagar Red Pitaya</string>
             </property>
            </widget>
           </item>
           <item row="7" column="1">
            <widget class="QLineEdit" name="txtCmdApagar">
             <property name="text">
              <string>poweroff</string>
             </property>
            </widget>
           </item>
           <item row="8" column="0" colspan="2">
            <widget class="QLabel" name="lblComandosAyuda">
             <property name="text">
              <string>Los comandos se pueden editar y se guardan al conectar. Con la simulación activa, conectá la pestaña Conexión a 192.168.1.100:1004 (TCP) con formato NMEA.</string>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
