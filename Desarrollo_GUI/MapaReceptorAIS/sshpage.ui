               <widget class="QSpinBox" name="spnTimeout">
                <property name="minimum">
                 <number>2</number>
                </property>
                <property name="maximum">
                 <number>120</number>
                </property>
                <property name="value">
                 <number>10</number>
                </property>
                <property name="suffix">
